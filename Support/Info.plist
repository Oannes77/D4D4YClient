<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  D4D4YClient 的 Info.plist（手写，替代 GENERATE_INFOPLIST_FILE 生成的版本）。
	  存在的唯一原因：后台刷新需要两个数组类型的键，而数组无法用 INFOPLIST_KEY_* 构建设置表达。
	  - UIBackgroundModes: fetch                    → BGAppRefreshTask 必需
	  - BGTaskSchedulerPermittedIdentifiers         → 必须与 Core/BackgroundRefresh.swift 的
	                                                  taskIdentifier 完全一致，否则注册会抛异常
	  其余键（CFBundleIdentifier / Executable / Version 等）由构建系统从构建设置注入，无需在此声明。
	  文件放在 Support/ 而不是 App/：Support 不在 project.yml 的 sources 里，
	  绝对不会被当成资源重复拷进 bundle（那会触发 "Multiple commands produce Info.plist"）。
	-->
	<key>CFBundleDisplayName</key>
	<string>4D4Y</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.d4d4y.client.refresh</string>
	</array>
</dict>
</plist>
